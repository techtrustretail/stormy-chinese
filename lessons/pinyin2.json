  "story": {
    "id": "st2",
    "title": "Stormy and the Busy Camel",
    "panels": [
      {"scene": "desert", "cast": ["stormy", "🐫"], "lines": [
        {"id": "s1", "who": "Stormy", "v": "S", "hz": "你好！你是骆驼吗？", "py": "Nǐ hǎo! Nǐ shì luòtuo ma?", "en": "Hello! Are you a camel?"},
        {"id": "s2", "who": "Camel", "v": "D", "hz": "是！我是骆驼。", "py": "Shì! Wǒ shì luòtuo.", "en": "Yes! I am a camel."}]},
      {"scene": "desert", "cast": ["🐫", "📦"], "lines": [
        {"id": "s3", "who": "Stormy", "v": "S", "hz": "你忙吗？", "py": "Nǐ máng ma?", "en": "Are you busy?"},
        {"id": "s4", "who": "Camel", "v": "D", "hz": "我很忙！很忙！", "py": "Wǒ hěn máng! Hěn máng!", "en": "I am very busy! Very busy!"}]},
      {"scene": "desert", "cast": ["stormy", "✏️"], "lines": [
        {"id": "s5", "who": "Stormy", "v": "S", "hz": "我有笔。我学汉语！", "py": "Wǒ yǒu bǐ. Wǒ xué Hànyǔ!", "en": "I have a pen. I learn Chinese!"}]},
      {"scene": "desert", "cast": ["👦", "👧"], "lines": [
        {"id": "s6", "who": "Camel", "v": "D", "hz": "他是谁？她是谁？", "py": "Tā shì shéi? Tā shì shéi?", "en": "Who is he? Who is she?"},
        {"id": "s7", "who": "Stormy", "v": "S", "hz": "他是哥哥，她是妈妈！", "py": "Tā shì gēge, tā shì māma!", "en": "He is big brother, she is mum!"}]},
      {"scene": "sunset", "cast": ["stormy", "🐫"], "lines": [
        {"id": "s8", "who": "Camel", "v": "D", "hz": "再见，猫猫！", "py": "Zàijiàn, māomao!", "en": "Goodbye, kitty!"},
        {"id": "s9", "who": "Stormy", "v": "S", "hz": "再见，骆驼！", "py": "Zàijiàn, luòtuo!", "en": "Goodbye, camel!"}]}
    ]
  },
